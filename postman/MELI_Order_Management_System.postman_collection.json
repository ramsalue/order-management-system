				{
					"name": "Create client",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test: Status code is 201\r",
									"pm.test(\"Status code is 201 Created\", function () {\r",
									"    pm.response.to.have.status(201);\r",
									"});\r",
									"\r",
									"// Test: Response has required fields\r",
									"pm.test(\"Response has client ID\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData).to.have.property('idClient');\r",
									"    pm.expect(jsonData.idClient).to.be.a('number');\r",
									"});\r",
									"\r",
									"// Save client ID for later use\r",
									"if (pm.response.code === 201) {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.environment.set(\"client_id\", jsonData.idClient);\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
