# ========================================
# MELI Order Management System
# Production Environment Variables
# ========================================
# CRITICAL: Never commit this file with real values
# Copy to .env.production and fill with real credentials
# Ensure .env.production is in .gitignore
# ========================================

# ========================================
# Database Configuration (REQUIRED)
# ========================================
DB_HOST=your-production-db-host.example.com
DB_PORT=5432
DB_NAME=meli_order_db_prod
DB_USERNAME=meli_prod_user
DB_PASSWORD=your-strong-production-password-here

# ========================================
# Application Configuration
# ========================================
SERVER_PORT=8080
MANAGEMENT_PORT=9090

# ========================================
# Logging Configuration
# ========================================
LOG_FILE_PATH=/var/log/meli/application.log